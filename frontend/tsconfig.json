{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "skipLibCheck": true,
    "strict": true, "noEmit": true, "jsx": "react-jsx", "isolatedModules": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
